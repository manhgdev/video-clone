# ElevenLabs TTS — comma-separated; rotates on 401/429/403
# (hoặc nhập trong Cấu hình → ElevenLabs)
ELEVENLABS_API_KEYS=sk_xxx,sk_yyy

# CapCut: để trống = tự tạo/ghi server/capcut_device.json (id riêng, tránh shark block)
# CAPCUT_DEVICE_JSON=/absolute/path/to/device.json

# Generated files under backend/public are cleaned at startup and daily.
VIDEO_CLONE_PUBLIC_RETENTION_DAYS=30

# VieNeu local TTS: auto = CUDA nếu có torch.cuda, không thì ONNX/CPU
# VIENEU_BACKEND=auto
# VIENEU_BACKEND=pytorch
# VIENEU_BACKEND=onnx
# VIENEU_PRECISION=int8

# API dịch cloud (hoặc nhập trong Cấu hình → API dịch cloud)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
